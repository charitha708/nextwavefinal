# ---- Next Wave Project Lab environment variables ----
# Copy this file to .env and fill in the values.
# The frontend requires Supabase URL + anon key. AI/email/Sheets can remain unconfigured for development.

# Supabase frontend configuration — replace both placeholders with your project values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- SERVER-SIDE ONLY: configure these as Supabase Edge Function secrets, not frontend variables ----
# AI Examiner (choose ONE provider, or leave blank for clearly labeled mock mode)
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=

# ---- SERVER-SIDE ONLY: Resend (email) ----
# Required for real email delivery; missing key means no email is sent
RESEND_API_KEY=
RESEND_FROM=Next Wave <workshop@yourdomain.com>
RESEND_WEBHOOK_SECRET=

# ---- Workshop details (shown in confirmation email) ----
WORKSHOP_DATE=To be announced
WORKSHOP_TIME=To be announced
WORKSHOP_JOIN_URL=To be shared before the session

# ---- SERVER-SIDE ONLY: Google Sheets (Apps Script Web App URL) ----
# Required for real spreadsheet sync
SHEETS_WEBAPP_URL=
SHEETS_WEBAPP_SECRET=
